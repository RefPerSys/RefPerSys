#include "refpersys.hh"

#pragma message "prologue part of parser_rps.cbrt"

#ifndef RPS_GITID
#error RPS_GITID is not defined by compilation command
#endif

#ifndef RPS_SHORTGITID
#error RPS_SHORTGITID is not defined by compilation command
#endif

#ifndef RPS_BASENAME
#error RPS_BASENAME not defined by compilation command
#endif

#ifndef RPS_BASEID
#error RPS_BASEID not defined by compilation command
#endif

//// The following constant strings are dlsym-ed (e.g. when you run
//// ./refpersys --version).  By convention their name should be tied
//// to the file name, so parser_rps.cbrt requires strings named
//// rps_parser_gitid etc... ["parser_rps" basename ↦ "parser" infix]
extern "C" const char rps_parser_gitid[];
const char rps_parser_gitid[] = RPS_GITID;

extern "C" const char rps_parser_shortgitid[];
const char rps_parser_shortgitid[] = RPS_SHORTGITID;

extern "C" const char rps_parser_basename[];
const char rps_parser_basename[] = RPS_BASENAME;

extern "C" const char rps_parser_baseid[];
const char rps_parser_baseid[] = RPS_BASEID;

extern "C" struct rpsruleparser_stack;

enum rps_rule_parser_keyw_enum {
  rpsrule_kw__None,
  rpsrule_kw_rule,
  rpsrule_kw_when,
  rpsrule_kw_then,
  rpsrule_kw_salience,
  rpsrule_kw_action,
  rpsrule_kw_assert,
  rpsrule_kw_retract,
  rpsrule_kw_modify,
  rpsrule_kw_and,
  rpsrule_kw_or,
  rpsrule_kw_not,
  rpsrule_kw__Last
};

%header%
#pragma message "header part of parser_rps.cbrt"
extern "C" const char rps_parser_gitid[];
extern "C" const char rps_parser_shortgitid[];
extern "C" const char rps_parser_basename[];
extern "C" const char rps_parser_baseid[];
extern "C" struct rps_rule_parser_data_st;
extern "C" enum rps_rule_parser_keyw_enum;
%%

%prefix rpsruleparser_
%end_token LEX_END

constexpr unsigned rps_magic_rule_parser_data = 0x72707372; // 'rpsr'
struct rps_rule_parser_data_st {
  unsigned rule_magic;
  unsigned rule_touchline;
  double rule_mtime;
  Rps_TokenSource* rule_toksrc;
  intptr_t rule_i;
  double rule_d;
  std::string rule_str;
  char rule_chunk_prefix[16];
  std::string rule_chunk_buf;
  void* rule_ptr;
  int rule_lineno;
  unsigned rule_count;
  std::string rule_path;
  Rps_Id rule_oid;
  Rps_ObjectRef rule_ob1;
  Rps_ObjectRef rule_ob2;
  Rps_Value rule_v1;
  Rps_Value rule_v2;
  std::vector<Rps_Value> rule_vectval;

  void check_carbdata_magic(int li = __builtin_LINE()) const {
    RPS_ASSERT(li > 0);
    if (RPS_UNLIKELY(rule_magic != rps_magic_rule_parser_data)) {
      RPS_FATALOUT("rps_rule_parser_data_st corruption at line #" << li);
    }
  }

  void check_carbdata_callframe(Rps_CallFrame* cf, int lin = __builtin_LINE()) const {
    check_carbdata_magic(lin);
    if (RPS_UNLIKELY(cf == nullptr)) {
      RPS_WARNOUT("no callframe from line #" << lin << " of parser_rps.cbrt");
    }
  }

  void incr_carbdata_line_number() {
    rule_lineno++;
  }

  int carbdata_line_number() const {
    return rule_lineno;
  }

  const std::string& carbdata_path() const {
    return rule_path;
  }

  void reset_carbdata(int lin = __builtin_LINE()) {
    check_carbdata_magic(lin);
    rule_i = 0;
    rule_d = 0.0;
    rule_toksrc = nullptr;
    rule_str.clear();
    memset(rule_chunk_prefix, 0, sizeof(rule_chunk_prefix));
    rule_chunk_buf.clear();
    rule_ptr = nullptr;
    rule_oid.clear_oid();
    rule_ob1 = nullptr;
    rule_ob2 = nullptr;
    rule_v1 = nullptr;
    rule_v2 = nullptr;
    rule_vectval.clear();
    rule_touchline = lin;
    rule_mtime = rps_elapsed_real_time();
  }

  void gc_carbdata_mark(Rps_GarbageCollector& gc, int li = __builtin_LINE()) {
    RPS_ASSERT(li > 0);
    gc.mark_obj(rule_ob1);
    gc.mark_obj(rule_ob2);
    gc.mark_value(rule_v1);
    gc.mark_value(rule_v2);
    for (Rps_Value& v : rule_vectval)
      gc.mark_value(v);
  }
};

extern "C" void rpsruleparser_garbage_collect_visit_stack(struct rpsruleparser_stack*,
                                                         Rps_GarbageCollector*);
%visit_params Rps_GarbageCollector* visitgc, rps_rule_parser_data_st* carbdata

extern "C" void rps_rule_parser_on_feed_me(rps_rule_parser_data_st* data,
                                           Rps_CallFrame* frame,
                                           void* extra,
                                           int lin = __builtin_LINE());

%params rps_rule_parser_data_st* data_rp, Rps_CallFrame* fram_rp, void* xtra_rp

%on_feed_me {                                                   \
  RPS_ASSERT(data_rp != nullptr);                               \
  _Pragma("message \"on_feed_me parser_rps\"");                 \
  data_rp->check_carbdata_callframe(fram_rp);                   \
  rps_rule_parser_on_feed_me(data_rp, fram_rp, xtra_rp);        \
}

/* Keyword tokens */
%token KEYW_RULE KEYW_WHEN KEYW_THEN KEYW_SALIENCE KEYW_ACTION
%token KEYW_ASSERT KEYW_RETRACT KEYW_MODIFY

/* Logical and relational operators */
%token AND OR NOT
%token ARROW
%token EQUAL NOT_EQUAL LESS LESS_EQUAL GREATER GREATER_EQUAL

/* Arithmetic & assignment operators */
%token PLUS MINUS ASTERISK SLASH PLUS_EQUAL

/* Delimiters and punctuation */
%token LPAREN RPAREN LBRACE RBRACE LBRACKET RBRACKET
%token COMMA SEMICOLON COLON DOT

/* Variable and literal tokens */
%token LOGIC_VAR
%type LOGIC_VAR: std::string

%token IDENT
%type IDENT: std::string

%token INT_LITERAL
%type INT_LITERAL: std::intptr_t

%token FLOAT_LITERAL
%type FLOAT_LITERAL: double

%token STRING_LITERAL
%type STRING_LITERAL: std::string

/* Code Chunk token */
%token CODE_CHUNK
%type CODE_CHUNK: std::string

%mode IN_COMMENT
%mode IN_STRING
%mode IN_CODE_CHUNK

%scanner%

: [\ \t\f\v\r]+ {
  /* Ignore whitespace */
}

: [\n] {
  data_rp->incr_carbdata_line_number();
}

: [/][/][^\n]* {
  /* Single-line comment */
}

: [/][\*] {
  $set_mode(IN_COMMENT);
}

<IN_COMMENT>: [\*][/] {
  $set_mode(DEFAULT);
}

<IN_COMMENT>: [\n] {
  data_rp->incr_carbdata_line_number();
}

<IN_COMMENT>: [^\*\n]+ {
  /* Skip comment body */
}

<IN_COMMENT>: [\*] {
  /* Skip asterisk */
}

/* Code chunk start without prefix: #{ ... }# */
: [#][\{] {
  data_rp->check_carbdata_callframe(fram_rp);
  memset(data_rp->rule_chunk_prefix, 0, sizeof(data_rp->rule_chunk_prefix));
  data_rp->rule_chunk_buf.clear();
  $set_mode(IN_CODE_CHUNK);
}

/* Code chunk start with alphanumeric prefix: #cpp{ ... }cpp# */
: [#][a-zA-Z0-9_]+[\{] {
  data_rp->check_carbdata_callframe(fram_rp);
  memset(data_rp->rule_chunk_prefix, 0, sizeof(data_rp->rule_chunk_prefix));
  data_rp->rule_chunk_buf.clear();
  size_t tlen = strlen($text);
  if (tlen > 2 && tlen - 2 < sizeof(data_rp->rule_chunk_prefix)) {
    strncpy(data_rp->rule_chunk_prefix, $text + 1, tlen - 2);
  }
  $set_mode(IN_CODE_CHUNK);
}

/* Code chunk end: standard }# */
<IN_CODE_CHUNK> CODE_CHUNK: [\}][#] {
  if (!data_rp->rule_chunk_prefix[0]) {
    $set_mode(DEFAULT);
    $$ = data_rp->rule_chunk_buf;
  } else {
    data_rp->rule_chunk_buf.append($text, strlen($text));
  }
}

/* Code chunk end: prefixed }prefix# */
<IN_CODE_CHUNK> CODE_CHUNK: [\}][a-zA-Z0-9_]+[#] {
  size_t tlen = strlen($text);
  if (data_rp->rule_chunk_prefix[0] &&
      tlen - 2 == strlen(data_rp->rule_chunk_prefix) &&
      !strncmp($text + 1, data_rp->rule_chunk_prefix, tlen - 2)) {
    $set_mode(DEFAULT);
    $$ = data_rp->rule_chunk_buf;
  } else {
    data_rp->rule_chunk_buf.append($text, tlen);
  }
}

/* Literal dollar in code chunk */
<IN_CODE_CHUNK>: [\$][\$] {
  data_rp->rule_chunk_buf.push_back('$');
}

/* Metavariable in code chunk: $identifier */
<IN_CODE_CHUNK>: [\$][a-zA-Z_][a-zA-Z0-9_]* {
  data_rp->rule_chunk_buf.append($text);
}

/* Count newlines in code chunk */
<IN_CODE_CHUNK>: [\n] {
  data_rp->incr_carbdata_line_number();
  data_rp->rule_chunk_buf.push_back('\n');
}

/* Non-control content inside code chunk */
<IN_CODE_CHUNK>: [^\}\$\n]+ {
  data_rp->rule_chunk_buf.append($text);
}

/* Single closing brace inside code chunk not followed by # */
<IN_CODE_CHUNK>: [\}] {
  data_rp->rule_chunk_buf.push_back('}');
}

: \" {
  data_rp->rule_str.erase();
  $set_mode(IN_STRING);
}

<IN_STRING> STRING_LITERAL: \" {
  $set_mode(DEFAULT);
  $$ = data_rp->rule_str;
}

<IN_STRING>: \\n {
  data_rp->rule_str.push_back('\n');
}

<IN_STRING>: \\t {
  data_rp->rule_str.push_back('\t');
}

<IN_STRING>: \\r {
  data_rp->rule_str.push_back('\r');
}

<IN_STRING>: \\\" {
  data_rp->rule_str.push_back('\"');
}

<IN_STRING>: \\\\ {
  data_rp->rule_str.push_back('\\');
}

<IN_STRING>: \P{Control} {
  data_rp->rule_str.append($text);
}

<IN_STRING>: [\n] {
  data_rp->incr_carbdata_line_number();
  data_rp->rule_str.push_back('\n');
}

KEYW_RULE: [r][u][l][e] { }
KEYW_WHEN: [w][h][e][n] { }
KEYW_THEN: [t][h][e][n] { }
KEYW_SALIENCE: [s][a][l][i][e][n][c][e] { }
KEYW_ACTION: [a][c][t][i][o][n] { }
KEYW_ASSERT: [a][s][s][e][r][t] { }
KEYW_RETRACT: [r][e][t][r][a][c][t] { }
KEYW_MODIFY: [m][o][d][i][f][y] { }

FLOAT_LITERAL: [\+\-]?([0-9]+\.)|([0-9]*\.[0-9]+)([eE][\+\-]?[0-9]+)? {
  $$ = strtod($text, nullptr);
}

INT_LITERAL: [\+\-]?0[xX][0-9a-fA-F]+ {
  $$ = (std::intptr_t)strtol($text, nullptr, 16);
}

INT_LITERAL: [\+\-]?[0-9]+ {
  $$ = (std::intptr_t)strtoll($text, nullptr, 10);
}

LOGIC_VAR: [\?][a-zA-Z_][a-zA-Z0-9_]* {
  $$ = std::string($text);
}

IDENT: [a-zA-Z_][a-zA-Z0-9_]* {
  $$ = std::string($text);
}

ARROW: [\-][>] { }
PLUS_EQUAL: [\+][=] { }
EQUAL: [=][=]? { }
NOT_EQUAL: [!][=] { }
LESS_EQUAL: [<][=] { }
GREATER_EQUAL: [>][=] { }
LESS: [<] { }
GREATER: [>] { }
AND: [&][&]? { }
AND: [a][n][d] { }
OR: \|\| { }
OR: \| { }
OR: [o][r] { }
NOT: [~] { }
NOT: [!] { }
NOT: [n][o][t] { }

PLUS: [\+] { }
MINUS: [\-] { }
ASTERISK: [\*] { }
SLASH: "/" { }

LPAREN: [\(] { }
RPAREN: [\)] { }
LBRACE: [\{] { }
RBRACE: [\}] { }
LBRACKET: \[ { }
RBRACKET: \] { }
COMMA: \, { }
SEMICOLON: \; { }
COLON: \: { }
DOT: "." { }

%grammar%
%nt rule_file rule_list rule_decl
%nt salience_opt
%nt condition_block condition_list condition_expr condition_term condition_factor
%nt pattern_binding object_pattern attr_constraint_list attr_constraint
%nt rel_op expr term factor primary_expr
%nt action_block action_list action_stmt
%nt assert_stmt retract_stmt modify_stmt put_stmt send_stmt
%nt attr_assignment_list attr_assignment arg_list

rule_file:
  rule_list {
    RPS_DEBUG_LOG(REPL, "parsed rule_file successfully");
  }

rule_list:
  /* empty */ { }

rule_list:
  rule_list rule_decl { }

rule_decl:
  KEYW_RULE IDENT salience_opt KEYW_WHEN condition_block KEYW_THEN action_block {
    data_rp->rule_count++;
    RPS_DEBUG_LOG(REPL, "parsed rule_decl " << $1);
  }

salience_opt:
  /* empty */ { }

salience_opt:
  KEYW_SALIENCE INT_LITERAL {
    data_rp->rule_i = $1;
  }

salience_opt:
  KEYW_SALIENCE MINUS INT_LITERAL {
    data_rp->rule_i = -$2;
  }

condition_block:
  condition_list { }

condition_list:
  condition_expr { }

condition_list:
  condition_list SEMICOLON condition_expr { }

condition_list:
  condition_list condition_expr { }

condition_expr:
  condition_term { }

condition_expr:
  condition_expr OR condition_term { }

condition_term:
  condition_factor { }

condition_term:
  condition_term AND condition_factor { }

condition_factor:
  pattern_binding { }

condition_factor:
  NOT condition_factor { }

condition_factor:
  LPAREN condition_expr RPAREN { }

pattern_binding:
  object_pattern { }

pattern_binding:
  LOGIC_VAR COLON object_pattern { }

object_pattern:
  IDENT LPAREN attr_constraint_list RPAREN { }

object_pattern:
  IDENT LPAREN RPAREN { }

attr_constraint_list:
  attr_constraint { }

attr_constraint_list:
  attr_constraint_list COMMA attr_constraint { }

attr_constraint:
  IDENT rel_op expr { }

attr_constraint:
  expr { }

rel_op:
  EQUAL { }

rel_op:
  NOT_EQUAL { }

rel_op:
  LESS { }

rel_op:
  LESS_EQUAL { }

rel_op:
  GREATER { }

rel_op:
  GREATER_EQUAL { }

expr:
  term { }

expr:
  expr PLUS term { }

expr:
  expr MINUS term { }

term:
  factor { }

term:
  term ASTERISK factor { }

term:
  term SLASH factor { }

factor:
  primary_expr { }

factor:
  MINUS factor { }

factor:
  NOT factor { }

primary_expr:
  INT_LITERAL { }

primary_expr:
  FLOAT_LITERAL { }

primary_expr:
  STRING_LITERAL { }

primary_expr:
  CODE_CHUNK { }

primary_expr:
  LOGIC_VAR { }

primary_expr:
  IDENT { }

primary_expr:
  LOGIC_VAR DOT IDENT { }

primary_expr:
  IDENT DOT IDENT { }

primary_expr:
  LPAREN expr RPAREN { }

action_block:
  action_list { }

action_list:
  /* empty */ { }

action_list:
  action_list action_stmt { }

action_stmt:
  assert_stmt SEMICOLON { }

action_stmt:
  retract_stmt SEMICOLON { }

action_stmt:
  modify_stmt SEMICOLON { }

action_stmt:
  put_stmt SEMICOLON { }

action_stmt:
  send_stmt SEMICOLON { }

assert_stmt:
  KEYW_ASSERT IDENT LPAREN attr_assignment_list RPAREN { }

assert_stmt:
  KEYW_ASSERT IDENT LPAREN RPAREN { }

retract_stmt:
  KEYW_RETRACT LOGIC_VAR { }

retract_stmt:
  KEYW_RETRACT IDENT { }

modify_stmt:
  KEYW_MODIFY LOGIC_VAR LBRACE attr_assignment_list RBRACE { }

put_stmt:
  IDENT primary_expr PLUS_EQUAL expr { }

put_stmt:
  primary_expr PLUS_EQUAL expr { }

put_stmt:
  IDENT primary_expr EQUAL expr { }

put_stmt:
  primary_expr EQUAL expr { }

send_stmt:
  IDENT primary_expr ARROW IDENT LPAREN arg_list RPAREN { }

send_stmt:
  IDENT primary_expr ARROW IDENT LPAREN RPAREN { }

attr_assignment_list:
  attr_assignment { }

attr_assignment_list:
  attr_assignment_list COMMA attr_assignment { }

attr_assignment:
  IDENT COLON expr { }

attr_assignment:
  IDENT EQUAL expr { }

arg_list:
  expr { }

arg_list:
  arg_list COMMA expr { }

%%
void
rps_rule_parser_on_feed_me(rps_rule_parser_data_st* data,
			   Rps_CallFrame* frame,
                           void* extra,
                           int lin)
{
#warning unimplemented rps_rule_parser_on_feed_me
  
}

#pragma message "epilogue part of parser_rps.cbrt"

