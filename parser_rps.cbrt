#include "refpersys.hh"

#pragma message "prologue part of parser_rps.cbrt"

#ifndef RPS_GITID
#error RPS_GITID is not defined by compilation command
#endif

#ifndef RPS_SHORTGITID
#error RPS_SHORTGITID is not defined by compilation command
#endif

#ifndef RPS_BASENAME
#error RPS_BASENAME not defined by compilation command
#endif

#ifndef RPS_BASEID
#error RPS_BASEID not defined by compilation command
#endif

//// The following constant strings are dlsym-ed (e.g. when you run
//// ./refpersys --version).  By convention their name should be tied
//// to the file name, so parser_rps.cbrt requires strings named
//// rps_parser_gitid etc... ["parser_rps" basename ↦ "parser" infix]
extern "C" const char rps_parser_gitid[];
const char rps_parser_gitid[] = RPS_GITID;

extern "C" const char rps_parser_shortgitid[];
const char rps_parser_shortgitid[] = RPS_SHORTGITID;

extern "C" const char rps_parser_basename[];
const char rps_parser_basename[] = RPS_BASENAME;

extern "C" const char rps_parser_baseid[];
const char rps_parser_baseid[] = RPS_BASEID;

/* Also alias rps_rule_parser_* symbols for consistency */
extern "C" const char rps_rule_parser_gitid[];
const char rps_rule_parser_gitid[] = RPS_GITID;

extern "C" const char rps_rule_parser_shortgitid[];
const char rps_rule_parser_shortgitid[] = RPS_SHORTGITID;

extern "C" const char rps_rule_parser_basename[];
const char rps_rule_parser_basename[] = RPS_BASENAME;

extern "C" const char rps_rule_parser_baseid[];
const char rps_rule_parser_baseid[] = RPS_BASEID;

extern "C" struct rpsruleparser_stack;

enum rps_rule_parser_keyw_enum {
  rpsrule_kw__None,
  rpsrule_kw_do,
  rpsrule_kw_rule,
  rpsrule_kw_when,
  rpsrule_kw_then,
  rpsrule_kw_salience,
  rpsrule_kw_action,
  rpsrule_kw_assert,
  rpsrule_kw_retract,
  rpsrule_kw_modify,
  rpsrule_kw_and,
  rpsrule_kw_or,
  rpsrule_kw_not,
  rpsrule_kw__Last
};

%header%
#pragma message "header part of parser_rps.cbrt"
extern "C" const char rps_parser_gitid[];
extern "C" const char rps_parser_shortgitid[];
extern "C" const char rps_parser_basename[];
extern "C" const char rps_parser_baseid[];
extern "C" const char rps_rule_parser_gitid[];
extern "C" const char rps_rule_parser_shortgitid[];
extern "C" const char rps_rule_parser_basename[];
extern "C" const char rps_rule_parser_baseid[];
extern "C" struct rps_rule_parser_data_st;
extern "C" enum rps_rule_parser_keyw_enum;
%%

%prefix rps_parser_
%end_token LEX_END

constexpr unsigned rps_magic_parser_data = 0x72707372; // 'rpsr'
struct rps_parser_data_st {
  unsigned parser_magic;		// should be rps_magic_parser_data
  unsigned parser_touchline;
  std::string parser_name;
  double parser_mtime;
  intptr_t parser_i;
  double parser_d;
  std::string parser_str;
  char parser_chunk_prefix[Rps_Id::buflen+4]; //// the 4 extra bytes are 0
  std::string parser_chunk_buf;
  void* parser_ptr;
  int parser_lineno;
  unsigned parser_count;
  std::string parser_path;
  Rps_Id parser_oid;
  Rps_ObjectRef parser_ob1;
  Rps_ObjectRef parser_ob2;
  Rps_Value parser_v1;
  Rps_Value parser_v2;
  std::vector<Rps_Value> parser_vectval;

  void check_carbdata_magic(int li = __builtin_LINE()) const {
    RPS_ASSERT(li > 0);
    if (RPS_UNLIKELY(parser_magic != rps_magic_parser_data)) {
      RPS_FATALOUT("rps_parser_data_st corruption at line #" << li);
    }
  }

  bool valid_carbdata_magic(int li= __builtin_LINE()) const {
    RPS_ASSERT(li>0);
    return RPS_LIKELY(parser_magic == rps_magic_parser_data);
  }

  void check_carbdata_callframe(Rps_CallFrame* cf, int lin = __builtin_LINE()) const {
    check_carbdata_magic(lin);
    if (RPS_UNLIKELY(cf == nullptr)) {
      RPS_WARNOUT("no callframe from line #" << lin << " of parser_rps.cbrt");
    }
  }

  void incr_carbdata_line_number() {
    parser_lineno++;
  }

  int carbdata_line_number() const {
    return parser_lineno;
  }

  const std::string& carbdata_path() const {
    return parser_path;
  }

  void reset_carbdata(int lin = __builtin_LINE()) {
    check_carbdata_magic(lin);
    parser_i = 0;
    parser_d = 0.0;
    parser_str.clear();
    memset(parser_chunk_prefix, 0, sizeof(parser_chunk_prefix));
    parser_chunk_buf.clear();
    parser_ptr = nullptr;
    parser_oid.clear_oid();
    parser_ob1 = nullptr;
    parser_ob2 = nullptr;
    parser_v1 = nullptr;
    parser_v2 = nullptr;
    parser_vectval.clear();
    parser_touchline = lin;
    parser_mtime = rps_elapsed_real_time();
  }

  void gc_carbdata_mark(Rps_GarbageCollector& gc, int li = __builtin_LINE()) {
    RPS_ASSERT(li > 0);
    gc.mark_obj(parser_ob1);
    gc.mark_obj(parser_ob2);
    gc.mark_value(parser_v1);
    gc.mark_value(parser_v2);
    for (Rps_Value& v : parser_vectval)
      gc.mark_value(v);
  }
};

enum rps_relop_en {
  RPS_RELOP_EQ = 1,
  RPS_RELOP_NE,
  RPS_RELOP_LT,
  RPS_RELOP_LE,
  RPS_RELOP_GT,
  RPS_RELOP_GE
};

static inline Rps_ObjectRef
rps_rule_symbol(Rps_CallFrame* cf, const std::string& name)
{
  return Rps_ObjectRef::make_new_strong_symbol(cf, name);
}

static inline Rps_Value
rps_rule_make_expr_op(Rps_CallFrame* cf, const char* op, Rps_Value left, Rps_Value right)
{
  std::vector<Rps_Value> v = { Rps_Value(rps_rule_symbol(cf, op)), left, right };
  return Rps_Value(Rps_TupleOb::collect(v));
}

static inline Rps_Value
rps_rule_make_unary_op(Rps_CallFrame* cf, const char* op, Rps_Value operand)
{
  std::vector<Rps_Value> v = { Rps_Value(rps_rule_symbol(cf, op)), operand };
  return Rps_Value(Rps_TupleOb::collect(v));
}

static inline Rps_Value
rps_rule_make_constraint(Rps_CallFrame* cf, const std::string& attr, int op, Rps_Value exprval)
{
  const char* op_str = "==";
  switch (op) {
    case RPS_RELOP_EQ: op_str = "=="; break;
    case RPS_RELOP_NE: op_str = "!="; break;
    case RPS_RELOP_LT: op_str = "<"; break;
    case RPS_RELOP_LE: op_str = "<="; break;
    case RPS_RELOP_GT: op_str = ">"; break;
    case RPS_RELOP_GE: op_str = ">="; break;
    default: op_str = "=="; break;
  }
  std::vector<Rps_Value> v = {
    Rps_Value(rps_rule_symbol(cf, "constraint")),
    Rps_Value(rps_rule_symbol(cf, attr)),
    Rps_Value(rps_rule_symbol(cf, op_str)),
    exprval
  };
  return Rps_Value(Rps_TupleOb::collect(v));
}

static inline Rps_Value
rps_rule_make_object_pattern(Rps_CallFrame* cf,
                             const std::string& type_name,
                             const std::string& var_name,
                             const std::vector<Rps_Value>& constraints)
{
  std::vector<Rps_Value> v;
  v.reserve(3 + constraints.size());
  v.push_back(Rps_Value(rps_rule_symbol(cf, "pattern")));
  v.push_back(Rps_Value(rps_rule_symbol(cf, type_name)));
  v.push_back(var_name.empty() ? Rps_Value() : Rps_Value(var_name));
  for (const auto& c : constraints) {
    v.push_back(c);
  }
  return Rps_Value(Rps_TupleOb::collect(v));
}

static inline Rps_Value
rps_rule_make_assert_action(Rps_CallFrame* cf,
                            const std::string& fact_type,
                            const std::vector<std::pair<Rps_ObjectRef, Rps_Value>>& attrs)
{
  std::vector<Rps_Value> v;
  v.reserve(2 + attrs.size() * 2);
  v.push_back(Rps_Value(rps_rule_symbol(cf, "assert")));
  v.push_back(Rps_Value(rps_rule_symbol(cf, fact_type)));
  for (const auto& p : attrs) {
    v.push_back(Rps_Value(p.first));
    v.push_back(p.second);
  }
  return Rps_Value(Rps_TupleOb::collect(v));
}

static inline Rps_Value
rps_rule_make_retract_action(Rps_CallFrame* cf, const std::string& target)
{
  std::vector<Rps_Value> v = {
    Rps_Value(rps_rule_symbol(cf, "retract")),
    Rps_Value(target)
  };
  return Rps_Value(Rps_TupleOb::collect(v));
}

static inline Rps_Value
rps_rule_make_modify_action(Rps_CallFrame* cf,
                            const std::string& target,
                            const std::vector<std::pair<Rps_ObjectRef, Rps_Value>>& attrs)
{
  std::vector<Rps_Value> v;
  v.reserve(2 + attrs.size() * 2);
  v.push_back(Rps_Value(rps_rule_symbol(cf, "modify")));
  v.push_back(Rps_Value(target));
  for (const auto& p : attrs) {
    v.push_back(Rps_Value(p.first));
    v.push_back(p.second);
  }
  return Rps_Value(Rps_TupleOb::collect(v));
}

static inline Rps_Value
rps_rule_make_put_action(Rps_CallFrame* cf,
                         const std::string& target,
                         Rps_Value dest,
                         bool is_append,
                         Rps_Value val)
{
  std::vector<Rps_Value> v = {
    Rps_Value(rps_rule_symbol(cf, is_append ? "+=" : "=")),
    target.empty() ? Rps_Value() : Rps_Value(rps_rule_symbol(cf, target)),
    dest,
    val
  };
  return Rps_Value(Rps_TupleOb::collect(v));
}

static inline Rps_Value
rps_rule_make_send_action(Rps_CallFrame* cf,
                          const std::string& target,
                          Rps_Value receiver,
                          const std::string& msg,
                          const std::vector<Rps_Value>& args)
{
  std::vector<Rps_Value> v;
  v.reserve(4 + args.size());
  v.push_back(Rps_Value(rps_rule_symbol(cf, "send")));
  v.push_back(target.empty() ? Rps_Value() : Rps_Value(rps_rule_symbol(cf, target)));
  v.push_back(receiver);
  v.push_back(Rps_Value(rps_rule_symbol(cf, msg)));
  for (const auto& a : args) {
    v.push_back(a);
  }
  return Rps_Value(Rps_TupleOb::collect(v));
}

static inline Rps_Value
rps_rule_make_display_action(Rps_CallFrame* cf, const std::vector<Rps_Value>& args)
{
  std::vector<Rps_Value> v;
  v.reserve(1 + args.size());
  v.push_back(Rps_Value(rps_rule_symbol(cf, "display")));
  for (const auto& a : args) {
    v.push_back(a);
  }
  return Rps_Value(Rps_TupleOb::collect(v));
}

static inline Rps_ObjectRef
rps_rule_make_rule_object(Rps_CallFrame* cf,
                          const std::string& name,
                          std::intptr_t salience,
                          const std::vector<Rps_Value>& lhs,
                          const std::vector<Rps_Value>& rhs)
{
  Rps_ObjectRef rule_ob = Rps_ObjectRef::make_object(cf, Rps_ObjectRef::the_object_class());
  Rps_ObjectRef sym_name = Rps_ObjectRef::the_name_object();
  Rps_ObjectRef sym_salience = rps_rule_symbol(cf, "salience");
  Rps_ObjectRef sym_when = rps_rule_symbol(cf, "when");
  Rps_ObjectRef sym_then = rps_rule_symbol(cf, "then");

  rule_ob->put_attr(sym_name, Rps_Value(name));
  rule_ob->put_attr(sym_salience, Rps_Value(salience));
  rule_ob->put_attr(sym_when, Rps_Value(Rps_TupleOb::collect(lhs)));
  rule_ob->put_attr(sym_then, Rps_Value(Rps_TupleOb::collect(rhs)));

  return rule_ob;
}

extern "C" void rpsruleparser_garbage_collect_visit_stack(struct rpsruleparser_stack*,
                                                         Rps_GarbageCollector*);
%visit_params Rps_GarbageCollector* visitgc, rps_parser_data_st* carbdata

extern "C" void rps_parser_on_feed_me(rps_parser_data_st* data,
                                           Rps_CallFrame* frame,
                                           void* extra,
                                           int lin = __builtin_LINE());

%params rps_parser_data_st* data_rp, Rps_CallFrame* fram_rp, void* xtra_rp

%on_feed_me {                                                   \
  RPS_ASSERT(data_rp != nullptr);                               \
  _Pragma("message \"on_feed_me parser_rps\"");                 \
  data_rp->check_carbdata_callframe(fram_rp);                   \
  rps_parser_on_feed_me(data_rp, fram_rp, xtra_rp);        \
}

/* Keyword tokens */
%token KEYW_RULE KEYW_WHEN KEYW_THEN KEYW_SALIENCE KEYW_ACTION
%token KEYW_ASSERT KEYW_RETRACT KEYW_MODIFY
%token KEYW_DISPLAY KEYW_DO KEYW_NAME

/* Logical and relational operators */
%token AND OR NOT
%token ARROW
%token EQUAL NOT_EQUAL LESS LESS_EQUAL GREATER GREATER_EQUAL

/* Arithmetic & assignment operators */
%token PLUS MINUS ASTERISK SLASH PLUS_EQUAL

/* Delimiters and punctuation */
%token LPAREN RPAREN LBRACE RBRACE LBRACKET RBRACKET
%token COMMA SEMICOLON COLON DOT

 /* TODO: use @! for fresh identifiers and to pass keywords as names */

/* Variable and literal tokens, they probably should give some
   RefPerSys instance... */
%token LOGIC_VAR
%type LOGIC_VAR: std::string 

%token IDENT
%type IDENT: std::string /* probably wrong, should be some object or
                            instance */

%token INT_LITERAL
%type INT_LITERAL: std::intptr_t

%token FLOAT_LITERAL
%type FLOAT_LITERAL: double

%token STRING_LITERAL
%type STRING_LITERAL: std::string

/* Code Chunk token */
%token CODE_CHUNK
%type CODE_CHUNK: Rps_Value

%mode IN_COMMENT
%mode IN_STRING
%mode IN_CODE_CHUNK

%scanner%

: [\ \t\f\v\r]+ {
  /* Ignore whitespace */
}

: [\n] {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->incr_carbdata_line_number();
}

: [/][/][^\n]* {
  /* Single-line comment */
}

: [/][\*] {
  $set_mode(IN_COMMENT);
}

<IN_COMMENT>: [\*][/] {
  $set_mode(DEFAULT);
}

<IN_COMMENT>: [\n] {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->incr_carbdata_line_number();
}

<IN_COMMENT>: [^\*\n]+ {
  /* Skip comment body */
}


<IN_COMMENT>: [\*] {
  /* Skip asterisk */
}

/* Code chunk start without prefix: #{ ... }# */
: [#][\{] {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->check_carbdata_callframe(fram_rp);
  memset(data_rp->parser_chunk_prefix, 0,
	 sizeof(data_rp->parser_chunk_prefix));
  data_rp->parser_chunk_buf.clear();
  $set_mode(IN_CODE_CHUNK);
}

/* Code chunk start with alphanumeric prefix: #cpp{ ... }cpp# */
: [#][a-zA-Z_][a-zA-Z0-9_]*[\{] {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->check_carbdata_callframe(fram_rp);
  memset(data_rp->parser_chunk_prefix, 0,
	 sizeof(data_rp->parser_chunk_prefix));
  data_rp->parser_chunk_buf.clear();
  size_t tlen = strlen($text);
  std::string srcname = data_rp->parser_name;
  if (tlen > 2 && tlen - 2 < sizeof(data_rp->parser_chunk_prefix)
      && tlen - 2 <= Rps_Id::buflen) {
    strncpy(data_rp->parser_chunk_prefix, $text + 1, tlen - 2);
  }
  else
    RPS_WARNOUT("in " << srcname << ":" << data_rp->carbdata_line_number()
                << " invalid code chunk prefix "
                << Rps_QuotedC_String($text));
  $set_mode(IN_CODE_CHUNK);
}

/* Code chunk end: standard }# */
<IN_CODE_CHUNK> CODE_CHUNK: [\}][#] {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  if (!data_rp->parser_chunk_prefix[0]) {
    $set_mode(DEFAULT);
    $$ = data_rp->parser_chunk_buf;
  } else {
    data_rp->parser_chunk_buf.append($text, strlen($text));
  }
}

/* Code chunk end: prefixed }prefix# */
<IN_CODE_CHUNK> CODE_CHUNK: [\}][a-zA-Z0-9_]+[#] {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  size_t tlen = strlen($text);
  if (data_rp->parser_chunk_prefix[0] &&
      tlen - 2 == strlen(data_rp->parser_chunk_prefix) &&
      !strncmp($text + 1, data_rp->parser_chunk_prefix, tlen - 2)) {
    $set_mode(DEFAULT);
    $$ = data_rp->parser_chunk_buf;
  } else {
    data_rp->parser_chunk_buf.append($text, tlen);
  }
}

/* Literal dollar in code chunk */
<IN_CODE_CHUNK>: [\$][\$] {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->parser_chunk_buf.push_back('$');
}

/* Metavariable in code chunk: $identifier */
<IN_CODE_CHUNK>: [\$][a-zA-Z_][a-zA-Z0-9_]* {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->parser_chunk_buf.append($text);
}

/* Count newlines in code chunk */
<IN_CODE_CHUNK>: [\n] {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->incr_carbdata_line_number();
  data_rp->parser_chunk_buf.push_back('\n');
}

/* Non-control content inside code chunk */
<IN_CODE_CHUNK>: [^\}\$\n]+ {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->parser_chunk_buf.append($text);
}

/* Single closing brace inside code chunk not followed by # */
<IN_CODE_CHUNK>: [\}] {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->parser_chunk_buf.push_back('}');
}

: \" {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->parser_str.erase();
  $set_mode(IN_STRING);
}

<IN_STRING> STRING_LITERAL: \" {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  $set_mode(DEFAULT);
  $$ = data_rp->parser_str;
}

<IN_STRING>: \\n {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->parser_str.push_back('\n');
}

<IN_STRING>: \\t {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->parser_str.push_back('\t');
}

<IN_STRING>: \\r {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->parser_str.push_back('\r');
}

<IN_STRING>: \\\" {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->parser_str.push_back('\"');
}

<IN_STRING>: \\\\ {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->parser_str.push_back('\\');
}

<IN_STRING>: \P{Control} {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->parser_str.append($text);
}

<IN_STRING>: [\n] {
  RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
  data_rp->incr_carbdata_line_number();
  data_rp->parser_str.push_back('\n');
}

/// carburetta/examples/tilly/directives.cbrt allow keywords like:::
KEYW_DO: do { }
KEYW_DISPLAY: display { }
KEYW_RULE: rule { }
KEYW_WHEN: when { }
KEYW_THEN: then { }
KEYW_SALIENCE: salience { }
KEYW_ACTION: action { }
KEYW_ASSERT: assert { }
KEYW_RETRACT: retract { }
KEYW_MODIFY: modify { }
KEYW_NAME: name[s]? { }

FLOAT_LITERAL: [\+\-]?([0-9]+\.)|([0-9]*\.[0-9]+)([eE][\+\-]?[0-9]+)? {
  $$ = strtod($text, nullptr);
}

INT_LITERAL: [\+\-]?0[xX][0-9a-fA-F]+ { // hex int literal
  $$ = (std::intptr_t)strtol($text, nullptr, 16);
}

INT_LITERAL: [\+\-]?0[bB][01]+ { // binary int literal
  $$ = (std::intptr_t)strtol($text, nullptr, 2);
}

INT_LITERAL: [\+\-]?0[0-7]+ { // octal int literal
  $$ = (std::intptr_t)strtol($text, nullptr, 8);
}


INT_LITERAL: [\+\-]?[0-9]+ { // decimal int literal
  $$ = (std::intptr_t)strtoll($text, nullptr, 10);
}

LOGIC_VAR: [\?][a-zA-Z_][a-zA-Z0-9_]* {
  /// should give some RefPerSys instance or object
  std::string logvarname = std::string($text);
}

IDENT: [a-zA-Z_][a-zA-Z0-9_]* {
  std::string identname = std::string($text);
}

ARROW: [\-][>] { }
PLUS_EQUAL: [\+][=] { }
EQUAL: [=][=]? { }
NOT_EQUAL: [!][=] { }
LESS_EQUAL: [<][=] { }
GREATER_EQUAL: [>][=] { }
LESS: [<] { }
GREATER: [>] { }
AND: [&][&]? { }
AND: [a][n][d] { }
OR: \|\| { }
OR: \| { }
OR: [o][r] { }
NOT: [~] { }
NOT: [!] { }
NOT: [n][o][t] { }

PLUS: [\+] { }
MINUS: [\-] { }
ASTERISK: [\*] { }
SLASH: "/" { }

LPAREN: [\(] { }
RPAREN: [\)] { }
LBRACE: [\{] { }
RBRACE: [\}] { }
LBRACKET: \[ { }
RBRACKET: \] { }
COMMA: \, { }
SEMICOLON: \; { }
COLON: \: { }
DOT: "." { }

%grammar%
%nt toplevel_file toplevel_list toplevel_elem parser_decl
%nt salience_opt
%nt condition_block condition_list condition_expr condition_term condition_factor
%nt pattern_binding object_pattern attr_constraint_list attr_constraint
%nt rel_op expr term factor primary_expr
%nt action_block action_list action_stmt
%nt assert_stmt retract_stmt modify_stmt put_stmt send_stmt display_stmt
%nt attr_assignment_list attr_assignment arg_list
%nt name_list name_decl

%type toplevel_file: int
%type toplevel_list: std::vector<Rps_ObjectRef>
%type toplevel_elem: Rps_ObjectRef
%type parser_decl: Rps_ObjectRef
%type name_decl: Rps_ObjectRef
%type salience_opt: std::intptr_t
%type primary_expr: Rps_Value
%type factor: Rps_Value
%type term: Rps_Value
%type expr: Rps_Value
%type rel_op: int
%type attr_constraint: Rps_Value
%type attr_constraint_list: std::vector<Rps_Value>
%type object_pattern: Rps_Value
%type pattern_binding: Rps_Value
%type condition_factor: Rps_Value
%type condition_term: Rps_Value
%type condition_expr: Rps_Value
%type condition_list: std::vector<Rps_Value>
%type condition_block: std::vector<Rps_Value>
%type attr_assignment: std::pair<Rps_ObjectRef, Rps_Value>
%type attr_assignment_list: std::vector<std::pair<Rps_ObjectRef, Rps_Value>>
%type arg_list: std::vector<Rps_Value>
%type assert_stmt: Rps_Value
%type retract_stmt: Rps_Value
%type modify_stmt: Rps_Value
%type put_stmt: Rps_Value
%type send_stmt: Rps_Value
%type display_stmt: Rps_Value
%type action_stmt: Rps_Value
%type action_list: std::vector<Rps_Value>
%type action_block: std::vector<Rps_Value>

toplevel_file:
  toplevel_list {
    RPS_ASSERT(data_rp && data_rp->valid_carbdata_magic());
    $$ = (int)$0.size();
    data_rp->parser_count = $$;
    RPS_DEBUG_LOG(REPL, "parsed toplevel_file successfully with " << $$ << " elements");
  }

toplevel_list:
  /* empty */ {
    $$ = std::vector<Rps_ObjectRef>();
  }

toplevel_list:
  toplevel_list toplevel_elem {
    $$ = std::move($0);
    $$.push_back($1);
  }

toplevel_elem:
  parser_decl {
    $$ = $0;
  }

toplevel_elem:
  name_decl {
    $$ = nullptr;
  }

parser_decl:
  KEYW_RULE IDENT salience_opt KEYW_WHEN condition_block KEYW_THEN action_block {
    data_rp->check_carbdata_callframe(fram_rp);
    $$ = rps_rule_make_rule_object(fram_rp, $1, $2, $4, $6);
    data_rp->parser_ob1 = $$;
    data_rp->parser_count++;
    RPS_DEBUG_LOG(REPL, "parsed parser_decl " << $1 << " salience=" << $2);
  }

name_decl:
  KEYW_NAME name_list {
    $$ = nullptr;
  }

name_list: /*empty*/ {
  }

name_list:
  IDENT name_list {
  }

salience_opt:
  /* empty */ {
    $$ = 0;
  }

salience_opt:
  KEYW_SALIENCE INT_LITERAL {
    $$ = $1;
    data_rp->parser_i = $1;
  }

salience_opt:
  KEYW_SALIENCE MINUS INT_LITERAL {
    $$ = -$2;
    data_rp->parser_i = -$2;
  }

condition_block:
  condition_list {
    $$ = std::move($0);
  }

condition_list:
  condition_expr {
    $$ = std::vector<Rps_Value>{ $0 };
  }

condition_list:
  condition_list SEMICOLON condition_expr {
    $$ = std::move($0);
    $$.push_back($2);
  }

condition_list:
  condition_list condition_expr {
    $$ = std::move($0);
    $$.push_back($1);
  }

condition_expr:
  condition_term {
    $$ = $0;
  }

condition_expr:
  condition_expr OR condition_term {
    $$ = rps_rule_make_expr_op(fram_rp, "or", $0, $2);
  }

condition_term:
  condition_factor {
    $$ = $0;
  }

condition_term:
  condition_term AND condition_factor {
    $$ = rps_rule_make_expr_op(fram_rp, "and", $0, $2);
  }

condition_factor:
  pattern_binding {
    $$ = $0;
  }

condition_factor:
  NOT condition_factor {
    $$ = rps_rule_make_unary_op(fram_rp, "not", $1);
  }

condition_factor:
  LPAREN condition_expr RPAREN {
    $$ = $1;
  }

pattern_binding:
  object_pattern {
    $$ = $0;
  }

pattern_binding:
  LOGIC_VAR COLON object_pattern {
    $$ = rps_rule_make_expr_op(fram_rp, ":", Rps_Value($0), $2);
  }

object_pattern:
  IDENT LPAREN attr_constraint_list RPAREN {
    $$ = rps_rule_make_object_pattern(fram_rp, $0, "", $2);
  }

object_pattern:
  IDENT LPAREN RPAREN {
    $$ = rps_rule_make_object_pattern(fram_rp, $0, "", {});
  }

attr_constraint_list:
  attr_constraint {
    $$ = std::vector<Rps_Value>{ $0 };
  }

attr_constraint_list:
  attr_constraint_list COMMA attr_constraint {
    $$ = std::move($0);
    $$.push_back($2);
  }

attr_constraint:
  IDENT rel_op expr {
    $$ = rps_rule_make_constraint(fram_rp, $0, $1, $2);
  }

attr_constraint:
  expr {
    $$ = $0;
  }

rel_op:
  EQUAL {
    $$ = RPS_RELOP_EQ;
  }

rel_op:
  NOT_EQUAL {
    $$ = RPS_RELOP_NE;
  }

rel_op:
  LESS {
    $$ = RPS_RELOP_LT;
  }

rel_op:
  LESS_EQUAL {
    $$ = RPS_RELOP_LE;
  }

rel_op:
  GREATER {
    $$ = RPS_RELOP_GT;
  }

rel_op:
  GREATER_EQUAL {
    $$ = RPS_RELOP_GE;
  }

expr:
  term {
    $$ = $0;
  }

expr:
  expr PLUS term {
    $$ = rps_rule_make_expr_op(fram_rp, "+", $0, $2);
  }

expr:
  expr MINUS term {
    $$ = rps_rule_make_expr_op(fram_rp, "-", $0, $2);
  }

term:
  factor {
    $$ = $0;
  }

term:
  term ASTERISK factor {
    $$ = rps_rule_make_expr_op(fram_rp, "*", $0, $2);
  }

term:
  term SLASH factor {
    $$ = rps_rule_make_expr_op(fram_rp, "/", $0, $2);
  }

factor:
  primary_expr {
    $$ = $0;
  }

factor:
  MINUS factor {
    $$ = rps_rule_make_unary_op(fram_rp, "-", $1);
  }

factor:
  NOT factor {
    $$ = rps_rule_make_unary_op(fram_rp, "not", $1);
  }

primary_expr:
  INT_LITERAL {
    $$ = Rps_Value($0);
  }

primary_expr:
  FLOAT_LITERAL {
    $$ = Rps_Value($0);
  }

primary_expr:
  STRING_LITERAL {
    $$ = Rps_Value($0);
  }

primary_expr:
  CODE_CHUNK {
    $$ = Rps_Value($0);
  }

primary_expr:
  LOGIC_VAR {
    $$ = Rps_Value($0);
  }

primary_expr:
  IDENT {
    $$ = Rps_Value(rps_rule_symbol(fram_rp, $0));
  }

primary_expr:
  LOGIC_VAR DOT IDENT {
    $$ = rps_rule_make_expr_op(fram_rp, ".", Rps_Value($0), Rps_Value(rps_rule_symbol(fram_rp, $2)));
  }

primary_expr:
  IDENT DOT IDENT {
    $$ = rps_rule_make_expr_op(fram_rp, ".", Rps_Value(rps_rule_symbol(fram_rp, $0)), Rps_Value(rps_rule_symbol(fram_rp, $2)));
  }

primary_expr:
  LPAREN expr RPAREN {
    $$ = $1;
  }

action_block:
  action_list {
    $$ = std::move($0);
  }

action_list:
  /* empty */ {
    $$ = std::vector<Rps_Value>();
  }

action_list:
  action_list action_stmt {
    $$ = std::move($0);
    $$.push_back($1);
  }

action_stmt:
  assert_stmt SEMICOLON {
    $$ = $0;
  }

action_stmt:
  retract_stmt SEMICOLON {
    $$ = $0;
  }

action_stmt:
  modify_stmt SEMICOLON {
    $$ = $0;
  }

action_stmt:
  put_stmt SEMICOLON {
    $$ = $0;
  }

action_stmt:
  send_stmt SEMICOLON {
    $$ = $0;
  }

action_stmt:
  display_stmt SEMICOLON {
    $$ = $0;
  }

display_stmt:
  KEYW_DISPLAY LPAREN arg_list RPAREN {
    $$ = rps_rule_make_display_action(fram_rp, $2);
  }

display_stmt:
  KEYW_DISPLAY LPAREN RPAREN {
    $$ = rps_rule_make_display_action(fram_rp, {});
  }

assert_stmt:
  KEYW_ASSERT IDENT LPAREN attr_assignment_list RPAREN {
    $$ = rps_rule_make_assert_action(fram_rp, $1, $3);
  }

assert_stmt:
  KEYW_ASSERT IDENT LPAREN RPAREN {
    $$ = rps_rule_make_assert_action(fram_rp, $1, {});
  }

retract_stmt:
  KEYW_RETRACT LOGIC_VAR {
    $$ = rps_rule_make_retract_action(fram_rp, $1);
  }

retract_stmt:
  KEYW_RETRACT IDENT {
    $$ = rps_rule_make_retract_action(fram_rp, $1);
  }

modify_stmt:
  KEYW_MODIFY LOGIC_VAR LBRACE attr_assignment_list RBRACE {
    $$ = rps_rule_make_modify_action(fram_rp, $1, $3);
  }

put_stmt:
  IDENT primary_expr PLUS_EQUAL expr {
    $$ = rps_rule_make_put_action(fram_rp, $0, $1, true, $3);
  }

put_stmt:
  primary_expr PLUS_EQUAL expr {
    $$ = rps_rule_make_put_action(fram_rp, "", $0, true, $2);
  }

put_stmt:
  IDENT primary_expr EQUAL expr {
    $$ = rps_rule_make_put_action(fram_rp, $0, $1, false, $3);
  }

put_stmt:
  primary_expr EQUAL expr {
    $$ = rps_rule_make_put_action(fram_rp, "", $0, false, $2);
  }

send_stmt:
  IDENT primary_expr ARROW IDENT LPAREN arg_list RPAREN {
    $$ = rps_rule_make_send_action(fram_rp, $0, $1, $3, $5);
  }

send_stmt:
  IDENT primary_expr ARROW IDENT LPAREN RPAREN {
    $$ = rps_rule_make_send_action(fram_rp, $0, $1, $3, {});
  }

attr_assignment_list:
  attr_assignment {
    $$ = std::vector<std::pair<Rps_ObjectRef, Rps_Value>>{ $0 };
  }

attr_assignment_list:
  attr_assignment_list COMMA attr_assignment {
    $$ = std::move($0);
    $$.push_back($2);
  }

attr_assignment:
  IDENT COLON expr {
    $$ = std::make_pair(rps_rule_symbol(fram_rp, $0), $2);
  }

attr_assignment:
  IDENT EQUAL expr {
    $$ = std::make_pair(rps_rule_symbol(fram_rp, $0), $2);
  }

arg_list:
  expr {
    $$ = std::vector<Rps_Value>{ $0 };
  }

arg_list:
  arg_list COMMA expr {
    $$ = std::move($0);
    $$.push_back($2);
  }

%%
void
rps_parser_on_feed_me(rps_parser_data_st* data,
                           Rps_CallFrame* frame,
                           void* extra,
                           int lin)
{
  RPS_ASSERT(data != nullptr);
  RPS_ASSERT(lin > 0);
  (void)frame;
  (void)extra;
  if (data->parser_ptr != nullptr) {
    Rps_TokenSource* toksrc = static_cast<Rps_TokenSource*>(data->parser_ptr);
    if (!toksrc->reached_end()) {
      toksrc->fill_current_line_buffer();
    }
  }
}

#pragma message "epilogue part of parser_rps.cbrt"

